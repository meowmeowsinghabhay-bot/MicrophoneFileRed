# ─── Local development (SQLite — default) ───
DATABASE_URL="file:./dev.db"

# ─── Vercel + Supabase (set BOTH in Vercel env vars) ───
# From Supabase → Connect (do NOT use db.xxx.supabase.co on Vercel — P1001):
#
# DATABASE_URL = Transaction pooler, port 6543:
# postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL = Session pooler, port 5432 (for build/migrations):
# postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# If Vercel build still can't reach DB, run locally once:
#   npm run db:push:supabase
# Then set SKIP_DB_PUSH=true on Vercel and redeploy.

# Optional — AI features (translation fallback works without this)
OPENAI_API_KEY=your_openai_api_key_here

# Reserved for future use
DEMO_MODE=false
