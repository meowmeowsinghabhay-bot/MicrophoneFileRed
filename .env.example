# ─── Local development (SQLite — default) ───
DATABASE_URL="file:./dev.db"

# ─── Vercel + Supabase (set BOTH in Vercel env vars) ───
# From Supabase → Connect (do NOT use db.xxx.supabase.co on Vercel — P1001):
#
# DATABASE_URL = Transaction pooler, port 6543:
# postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# (pgbouncer=true and connection_limit=1 are auto-added at runtime if missing)
#
# DIRECT_URL = Session pooler, port 5432 (for setup/migrations):
# postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#
# One-time production DB init (after first deploy):
#   https://YOUR-APP.vercel.app/api/setup-database?secret=intellishala-setup-2026
#
# Or run locally once:
#   npm run db:push:supabase

# Optional — AI features (translation fallback works without this)
OPENAI_API_KEY=your_openai_api_key_here

# Optional — one-time DB setup via browser (see README)
SETUP_SECRET=intellishala-setup-2026
